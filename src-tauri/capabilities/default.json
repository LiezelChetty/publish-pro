{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Publish Pro desktop permissions for local document opening, project saving, app-data autosave, and exported PDF reveal/open actions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$TEMP/**" }
      ]
    }
  ]
}
