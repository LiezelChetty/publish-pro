{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Publish Pro",
  "version": "0.9.0",
  "identifier": "com.designovation.publishpro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Publish Pro",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "publisher": "Designovation",
    "copyright": "Copyright Designovation. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Professional local-first PDF publishing workspace.",
    "longDescription": "Publish Pro is a local-first professional document publishing workspace for assembling, reviewing, and publishing PDF document packages.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pproj"],
        "name": "Publish Pro Project",
        "description": "Publish Pro project file",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
